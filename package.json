{
  "name": "linkr-platform",
  "version": "1.0.0",
  "private": true,
  "description": "LINKR multi-profile digital contact platform on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public --live-reload",
    "build": "echo 'Static assets ready in public/'",
    "deploy": "wrangler pages deploy public",
    "backup:deploy": "wrangler deploy --config wrangler.backup.toml",
    "d1:init": "wrangler d1 execute linkr-db --local --file=./migrations/0001_init.sql",
    "d1:init:prod": "wrangler d1 execute linkr-db --remote --file=./migrations/0001_init.sql",
    "typecheck": "tsc --noEmit",
    "ai:handoff": "node tools/handoff.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.10"
  }
}
